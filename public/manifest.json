{
  "manifest_version": 3,
  "name": "Cotações: alertas de moedas, cripto e índices",
  "short_name": "Cotações",
  "version": "1.0.0",
  "description": "Acompanhe até 5 moedas, cripto ou índices e receba um aviso quando algum se mover rápido.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "host_permissions": [
    "https://economia.awesomeapi.com.br/*",
    "https://data-api.binance.vision/*",
    "https://api.hyperliquid.xyz/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cotações",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
